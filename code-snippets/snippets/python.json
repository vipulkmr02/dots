{
  "Retry Loop": {
    "prefix": "retry",
    "body": [
      "attempts = ${1:3}",
      "STOP = ${2:False}",
      "",
      "for attempt in range(1, attempts + 1):",
      "    if STOP:",
      "        break",
      "",
      "    if attempt > 1:",
      "        print(f\"Attempt {attempt}\")",
      "",
      "    $0"
    ],
    "description": "Retry loop with STOP flag and attempt logging"
  }
}
